# Anthropic API key — required
ANTHROPIC_API_KEY=sk-ant-...

# Model to use (default: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# NestJS backend port (default: 3001)
PORT=3001

# Next.js BFF uses this to reach NestJS (only needed when running without Docker)
API_URL=http://localhost:3001

# Redis connection URL (only needed when running without Docker)
REDIS_URL=redis://localhost:6379

# Session store backend: "memory" (default) or "redis"
SESSION_STORE=redis
